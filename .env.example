# Postgres connection string. In Coolify, create a Postgres resource and
# paste its connection string here (as an env var on the app resource).
DATABASE_URL="postgresql://user:password@host:5432/makeurmark"

# Admin login. Generate the base64-encoded hash once locally, never commit
# the plaintext password:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync('your-password', 10)).toString('base64'))"
# IMPORTANT: this is base64-encoded (not the raw "$2b$10$..." hash) because
# both Next.js's .env parser AND some hosting platforms' env var storage
# (Coolify included) treat literal `$` characters as variable-interpolation
# syntax and silently mangle them. Base64 has no `$`, so it sidesteps the
# problem entirely — the app decodes it at runtime before comparing.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD_HASH_B64="replace-with-a-base64-encoded-bcrypt-hash"

# Random secret used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-a-random-32-byte-base64-string"

# Where uploaded product/content images are written.
# In Coolify, mount a persistent volume at this path so uploads survive redeploys.
UPLOADS_DIR="/data/uploads"
