# Postgres connection string. In Coolify, create a Postgres resource and
# paste its connection string here (as an env var on the app resource).
DATABASE_URL="postgresql://user:password@host:5432/makeurmark"

# Admin login. Generate the hash once locally, never commit the plaintext:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# IMPORTANT: Next.js expands $VAR syntax in .env files, so every literal `$`
# in the bcrypt hash below MUST be escaped as `\$` or it will be silently
# stripped out and login will fail with "Admin account is not configured".
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD_HASH="\$2b\$10\$replace-with-a-real-bcrypt-hash"

# Random secret used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-a-random-32-byte-base64-string"

# Where uploaded product/content images are written.
# In Coolify, mount a persistent volume at this path so uploads survive redeploys.
UPLOADS_DIR="/data/uploads"
